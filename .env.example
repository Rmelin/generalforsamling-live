# Kopiér til .env og ret værdierne:  cp .env.example .env

# Port på host-maskinen
PORT=8000

# Navn vist i toppen af skærmene
EVENT_NAME=Generalforsamling 2026

# FOH-login (administration)
FOH_USERNAME=admin
FOH_PASSWORD=skift-mig

# Sceneadgangskode (dirigenternes touchskærm)
STAGE_PASSWORD=skift-mig-ogsaa

# Nøgle til fysisk FOH-betjening (Pimoroni Presto). Tom = slået fra.
# Generér med:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DEVICE_TOKEN=

# Hemmelig nøgle til login-cookies. Tom = genereres automatisk og gemmes i datavolumen.
# Generér evt. med:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Indlæs eksempeldata, hvis databasen er tom (true/false)
SEED_DEMO_DATA=true

# Hvor længe et login gælder (sekunder). Standard: 7 dage
SESSION_MAX_AGE=604800

# Databasefil (i Docker styres den af docker-compose.yml)
DATABASE_PATH=data/live.db
